{
  "name": "gnss-server",
  "version": "0.1.0",
  "description": "Ingest NMEA from multiple GNSS antennas over TCP and stream normalized fixes (UTM/LLH/ECEF + accuracy) to a React SPA via WebSocket and REST.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/core"
  ],
  "scripts": {
    "dev": "npm run build:core && tsx watch src/index.ts",
    "build:core": "npm run build -w packages/core",
    "build": "npm run build:core && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "replay": "tsx scripts/replay-nmea.ts"
  },
  "dependencies": {
    "@ikaros-arch/gnss-core": "^0.1.0",
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^5.0.2"
  }
}
