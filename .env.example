# Copy to .env and adjust as needed.

# Host ports published by docker compose
GNSS_TCP_PORT=9100
GNSS_HTTP_PORT=9200

# Logging
LOG_LEVEL=info
# Set REDACT_IPS=true to replace client IP addresses with [redacted] in all logs.
# REDACT_IPS=true

# TCP antenna connections
# MAX_CONNECTIONS=16
# TCP_IDLE_TIMEOUT_MS=30000

# Remove antennas from memory after this many milliseconds of inactivity (default: 15 min).
# ANTENNA_PURGE_MS=900000

# Output CRS for fix data delivered to the SPA.
# EPSG:32635 = WGS84 / UTM zone 35N.
OUTPUT_CRS=EPSG:32635
