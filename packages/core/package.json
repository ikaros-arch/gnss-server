{
  "name": "@ikaros-arch/gnss-core",
  "version": "0.1.0",
  "description": "NMEA-0183 parsing and normalisation to LLH / ECEF / projected coordinates with accuracy and RTK status. The pure core of gnss-server, reusable in browsers and native shells.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/ikaros-arch/gnss-server.git",
    "directory": "packages/core"
  },
  "keywords": ["nmea", "gnss", "gps", "rtk", "gga", "gst", "utm", "ecef", "emlid"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "proj4": "^2.11.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
